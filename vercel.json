{
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/(.*\\.(jpg|png|jpeg|gif|ico|svg|webp))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
